{
  "name": "premiere-timeline-audio-player",
  "version": "1.0.0",
  "description": "Ultra-minimal Premiere Pro style timeline multi-track audio player. One track per file in /vocals, with original filenames. Fully responsive, mobile-first with touch interactions.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "deploy": "npm run build && node scripts/deploy-gh-pages.mjs"
  },
  "keywords": [
    "audio",
    "daw",
    "premiere-pro",
    "timeline",
    "multitrack",
    "waveform",
    "webaudio"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.0",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.24.0",
    "gh-pages": "^6.1.0"
  }
}
